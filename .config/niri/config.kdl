// Check the wiki for a full description of the configuration:
// https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction

config-notification {
    disable-failed
}

gestures {
    hot-corners {
        off
    }
}

input {
    keyboard {
        xkb { }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse { }

    trackpoint { }
}

layout {
    background-color "transparent"

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // preset-window-heights { }

    default-column-width { proportion 0.5; }

    // default-column-width {}

    border {
        off
    }
    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
    }
    struts { }
}

prefer-no-csd

blur {
    passes 2
    offset 1.5
    noise 0.02
    saturation 1.1
}

animations { }

debug {
    honor-xdg-activation-with-invalid-serial
}

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

overview {
    workspace-shadow {
        off
    }
}

hotkey-overlay {
    skip-at-startup
}

// Override to disable super+tab
recent-windows {
    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

environment {
  XDG_CURRENT_DESKTOP "niri"
}

layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

layer-rule {
    match namespace="^dms:"
    background-effect {
        xray false
    }
}

window-rule {
    match app-id=r#"com.danklinux.dms$"#
    open-floating true
    background-effect {
        xray false
    }
}
window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=16 y=16 relative-to="bottom-right"
    open-focused false
}
window-rule {
    match app-id="kitty"
    draw-border-with-background false
}
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id="^steam$" title="^Friends List$"
    match app-id="^QQ$"
    match app-id=r#"^org\.telegram\.desktop$"#
    match app-id="^v2rayN$"
    match app-id=r#"^org\.fcitx\.fcitx5-config-qt$"#
    open-floating true
}
window-rule {
    match app-id="^scrcpy$" title="^PLC110$"
    default-column-width { fixed 2100; }
    default-window-height { fixed 954; }
}
window-rule {
    match app-id=r#"^org\.telegram\.desktop$"# title="^Media viewer$"
    open-fullscreen false
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.66666; }
}
// Workaround the Firefox bug of not aligning to the physical pixel correctly
// when the output has a fractional scale.
window-rule {
    match app-id="^firefox$"
    default-column-width { proportion 0.66666; }
    default-window-height { fixed 1048; }
}
window-rule {
    match app-id="^kitty$"
    match app-id="^org.gnome.Nautilus$"
    match app-id="^dev.zed.Zed$"
    default-column-width { proportion 0.33333; }
}
window-rule {
    match app-id="^steam_app_1510030$"
    open-fullscreen true
}

// Include dms files
include "dms/colors.kdl"
include "dms/layout.kdl"
include "dms/alttab.kdl"
include "dms/binds.kdl"
include "dms/outputs.kdl"
include "dms/cursor.kdl"
include "dms/windowrules.kdl"
