source $VIMRUNTIME/defaults.vim

set fileencodings=utf-8,ucs-bom,gb18030,gbk,gb2312,cp936

set tabstop=2
set shiftwidth=0
set expandtab
set autoindent

set hidden
set cursorline
set number
set background=dark
colorscheme catppuccin
hi Normal guibg=NONE ctermbg=NONE

set backup
set updatecount=100
set undofile
